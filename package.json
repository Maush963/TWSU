{
  "name": "twsu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run check:tokens",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "seed:clean": "sanity exec scripts/seed-clean.ts --with-user-token",
    "typegen": "sanity schema extract --force --path sanity-schema.json && sanity typegen generate"
  },
  "dependencies": {
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^8.13.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.20.0",
    "next": "16.4.3",
    "next-sanity": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.20.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
